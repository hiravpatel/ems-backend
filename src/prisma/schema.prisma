generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ROLE {
  ADMIN
  EMPLOYEE
}

enum DEPARTMENT {
  HR
  IT
  Finance
  Sales
  Marketing
}

enum STATUS {
  Active
  Inactive
}

enum POSITION {
  HR_Executive
  Software_Developer
  Payroll_Executive
  Sales_Manager
  Marketing_Manager
}

enum LEAVESTATUS {
  Pending
  Approved
  Rejected
}

enum OTPSTATUS {
  PENDING
  VERIFIED
  EXPIRED
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName     String   @default("")
  lastName      String   @default("")
  email         String   @unique
  contactNumber String
  joiningDate   DateTime
  password      String

  role       ROLE       @default(EMPLOYEE)
  position   POSITION
  department DEPARTMENT
  status     STATUS

  employeeCode String?
  salary       Float

  departmentSalaryId String   @db.ObjectId
  departmentSalary   DepartmentSalary @relation(fields: [departmentSalaryId], references: [id])

  personalInfo   PersonalInfo?
  educationInfo  EducationInfo?
  leaves         Leave[]
  payrolls       Payroll[]
  otps           UserOtp[]

  isFirstLogin Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model UserOtp {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  otp       String
  status    OTPSTATUS @default(PENDING)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PersonalInfo {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  fatherName    String?
  fatherContact String?
  motherName    String?
  motherContact String?
  address       String?
  dateOfBirth   DateTime?

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EducationInfo {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  uDegree  String?
  uCollege String?
  uYear    String?
  uCGPA    Float?

  pDegree  String?
  pCollege String?
  pYear    String?
  pCGPA    Float?

  phdResearch String?
  phdCollege  String?
  phdYear     String?
  phdResult   String?

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DepartmentSalary {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  department  DEPARTMENT @unique
  basicSalary Float
  allowance   Float
  deduction   Float

  users User[]

  createdAt DateTime @default(now())
}

model Payroll {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  employeeId  String @db.ObjectId
  month       String
  basicSalary Float
  allowance   Float
  deduction   Float
  netSalary   Float
  payrollStatus String

  employee User @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())

  @@unique([employeeId, month])
}

model LeaveType {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  leaveType   String
  description String

  leaves Leave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model Leave {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  employeeId  String @db.ObjectId
  leaveTypeId String @db.ObjectId

  fromDate    DateTime
  toDate      DateTime
  description String?
  status      LEAVESTATUS @default(Pending)

  employee  User      @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
