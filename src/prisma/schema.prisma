generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ROLE {
  ADMIN
  EMPLOYEE
}

enum DEPARTMENT {
  HR
  IT
  Finance
  Sales
  Marketing
}

enum STATUS {
  Active
  Inactive
}

enum POSITION {
  HR_Executive
  Software_Developer
  Payroll_Executive
  Sales_Manager
  Marketing_Manager
}

enum LEAVESTATUS {
  Pending
  Approved
  Rejected
}


model User {
  id                 Int        @id @default(autoincrement())
  firstName          String     @default("")
  lastName           String     @default("")
  email              String     @unique
  contactNumber      String
  joiningDate        DateTime
  password           String
  role               ROLE       @default(EMPLOYEE)
  position           POSITION
  department         DEPARTMENT
  status             STATUS
  employeeCode       String?

  departmentSalaryId Int
  salary             Float
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  //Back Relation
  departmentSalary DepartmentSalary @relation(fields: [departmentSalaryId], references: [id])
  leaves           Leave[]
  payrolls         Payroll[]
}

model DepartmentSalary {
  id          Int        @id @default(autoincrement())
  department  DEPARTMENT @unique
  basicSalary Float
  allowance   Float
  deduction   Float
  createdAt   DateTime   @default(now())

  //Back Relation
  users User[]
}

model Payroll {
  id            Int           @id @default(autoincrement())
  employeeId    Int
  month         String
  basicSalary   Float
  allowance     Float
  deduction     Float
  netSalary     Float
  payrollStatus String
  createdAt     DateTime      @default(now())

  //Back Relation
  employee User @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month])
}

model LeaveType {
  id          Int       @id @default(autoincrement())
  leaveType   String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  //Back Relation
  leaves Leave[]
}

model Leave {
  id          Int         @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  fromDate    DateTime
  toDate      DateTime
  description String?
  status      LEAVESTATUS @default(Pending)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  //Relations
  employee  User      @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
}
