generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ROLE {
  ADMIN
  EMPLOYEE
}

enum DEPARTMENT {
  HR
  IT
  Finance
  Sales
  Marketing
}

enum STATUS {
  Active
  Inactive
}

enum POSITION {
  HR_Executive
  Software_Developer
  Payroll_Executive
  Sales_Manager
  Marketing_Manager
}

enum LEAVESTATUS {
  Pending
  Approved
  Rejected
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  firstName     String     @default("")
  lastName      String     @default("")
  email         String     @unique
  contactNumber String
  joiningDate   DateTime
  password      String
  role          ROLE       @default(EMPLOYEE)
  position      POSITION
  department    DEPARTMENT
  status        STATUS
  employeeCode  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  // Relations
  leaves Leave[]
}

model LeaveType {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  leaveType   String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  leaves Leave[]
}

model Leave {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  employeeId  String      @db.ObjectId
  leaveTypeId String      @db.ObjectId
  fromDate    DateTime
  toDate      DateTime
  description String?
  status      LEAVESTATUS @default(Pending)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  employee  User      @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
}
